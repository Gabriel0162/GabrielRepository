      <indicators xsi:type="dataquality.indicators:BlankCountIndicator" xmi:id="_xi9ETE1oEfGMRo5Q24UK7Q" count="104" computed="true">
        <parameters xmi:id="_xi9ETU1oEfGMRo5Q24UK7Q"/>
        <analyzedElement xsi:type="relational:TdColumn" href="../../../metadata/connections/MDM_Clientes_0.1.item#_kOEiVko9EfGFud5DE7Ca9Q"/>
        <indicatorDefinition href="../../../TDQ_Libraries/Indicators/System Indicators/Simple Statistics/Blank_Count_0.1.definition#_ccHq0xF2Ed2PKb6nEJEvhw"/>
        <instantiatedExpressions xsi:type="relational:TdExpression" xmi:id="_X3p22k2AEfGMRo5Q24UK7Q" body="SELECT COUNT(`Nombre_Cliente`) FROM `mdm_clientes`.`personas` WHERE TRIM(`Nombre_Cliente`) = '' " language="MySQL"/>
        <builtInIndicatorDefinition xmi:id="_X1TtcE2AEfGMRo5Q24UK7Q" name="Blank Count" label="Blank Count">
          <taggedValue xmi:id="_X1TtcU2AEfGMRo5Q24UK7Q" tag="Description" value="counts the number of blank rows. A blank is a non null textual data that contains only white spaces (or nothing). Note that Oracle does not distinguish between the empty string and the null value"/>
          <taggedValue xmi:id="_X1Ttck2AEfGMRo5Q24UK7Q" tag="Purpose" value="evaluates the number of blank records"/>
          <sqlGenericExpression xmi:id="_X1Ttc02AEfGMRo5Q24UK7Q" body="SELECT COUNT(&lt;%=__COLUMN_NAMES__%>) FROM &lt;%=__TABLE_NAME__%> WHERE TRIM(&lt;%=__COLUMN_NAMES__%>) = '' &lt;%=__AND_WHERE_CLAUSE__%>" language="SQL"/>
          <sqlGenericExpression xmi:id="_X1TtdE2AEfGMRo5Q24UK7Q" body="SELECT COUNT(&lt;%=__COLUMN_NAMES__%>) FROM &lt;%=__TABLE_NAME__%>  WHERE TRIM(&lt;%=__COLUMN_NAMES__%>) IS NULL &lt;%=__AND_WHERE_CLAUSE__%>" language="Oracle"/>
          <sqlGenericExpression xmi:id="_X1TtdU2AEfGMRo5Q24UK7Q" body="SELECT COUNT(&lt;%=__COLUMN_NAMES__%>) FROM &lt;%=__TABLE_NAME__%>  WHERE LTRIM(RTRIM(&lt;%=__COLUMN_NAMES__%>)) = '' &lt;%=__AND_WHERE_CLAUSE__%>" language="DB2"/>
          <sqlGenericExpression xmi:id="_X1Ttdk2AEfGMRo5Q24UK7Q" body="SELECT COUNT(&lt;%=__COLUMN_NAMES__%>) FROM &lt;%=__TABLE_NAME__%>  WHERE LTRIM(RTRIM(&lt;%=__COLUMN_NAMES__%>)) = '' &lt;%=__AND_WHERE_CLAUSE__%>" language="Microsoft SQL Server"/>
          <sqlGenericExpression xmi:id="_X1Ttd02AEfGMRo5Q24UK7Q" body="SELECT COUNT(&lt;%=__COLUMN_NAMES__%>) FROM &lt;%=__TABLE_NAME__%> WHERE (&lt;%=__COLUMN_NAMES__%> = '' or RTRIM(LTRIM(&lt;%=__COLUMN_NAMES__%>)) = '') &lt;%=__AND_WHERE_CLAUSE__%>" language="Adaptive Server Enterprise | Sybase Adaptive Server IQ"/>
        </builtInIndicatorDefinition>
      </indicators>
