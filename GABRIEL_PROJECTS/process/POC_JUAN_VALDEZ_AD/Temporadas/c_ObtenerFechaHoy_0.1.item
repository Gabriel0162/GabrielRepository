  <node componentName="tJava" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="240" posY="120">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJava_1" show="false"/>
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="context.fechaHoy = TalendDate.getDate(&quot;dd-MM-yyyy&quot;);&#xD;&#xA;&#xD;&#xA;context.fechaHoyDate = TalendDate.parseDate(&quot;dd-MM-yyyy&quot;, TalendDate.getDate(&quot;dd-MM-yyyy&quot;));&#xD;&#xA;&#xD;&#xA;context.fechaHoyCurrentDate = TalendDate.formatDate(&quot;dd-MM-yyyy&quot;, context.fechaHoyDate);&#xD;&#xA;&#xD;&#xA;context.fechaHoyNumero = Long.toString(System.currentTimeMillis());&#xD;&#xA;&#xD;&#xA;//long timestamp = new java.util.Date().getTime();&#xD;&#xA;//context.fechaHoyNumero = timestamp;&#xD;&#xA;&#xD;&#xA;System.out.println(&quot;Fecha de hoy en formato String: &quot; + context.fechaHoy);&#xD;&#xA;&#xD;&#xA;System.out.println(&quot;Fecha de hoy en formato Date: &quot; + context.fechaHoyDate);&#xD;&#xA;&#xD;&#xA;System.out.println(&quot;Fecha de hoy en formato Current: &quot; + context.fechaHoyCurrentDate);&#xD;&#xA;&#xD;&#xA;System.out.println(&quot;Fecha de hoy en formato Numerico: &quot; + context.fechaHoyNumero);&#xD;&#xA;&#xD;&#xA;"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJava_1"/>
  </node>
