      <outputTables sizeState="INTERMEDIATE" name="Personas_Hash">
        <mapperTableEntries name="id_cliente" expression="row1.id_cliente " type="id_Integer" nullable="true"/>
        <mapperTableEntries name="Nombre_Cliente" expression="row1.Nombre_Cliente " type="id_String" nullable="true"/>
