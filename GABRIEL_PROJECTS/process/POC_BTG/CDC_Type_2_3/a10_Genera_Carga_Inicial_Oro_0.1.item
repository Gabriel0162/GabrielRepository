        <mapperTableEntries name="SCD_Hash_MD5" expression="new Object() {&#xD;&#xA;&#x9;&#x9;    public String calcMD5(String input) {&#xD;&#xA;&#x9;&#x9;        try {&#xD;&#xA;&#x9;&#x9;            java.security.MessageDigest md = java.security.MessageDigest.getInstance(&quot;MD5&quot;);&#xD;&#xA;&#x9;&#x9;            byte[] hash = md.digest(input.getBytes(&quot;UTF-8&quot;));&#xD;&#xA;&#x9;&#x9;            StringBuilder sb = new StringBuilder();&#xD;&#xA;&#x9;&#x9;            for (byte b : hash) {&#xD;&#xA;&#x9;&#x9;                sb.append(String.format(&quot;%02x&quot;, b));&#xD;&#xA;&#x9;&#x9;            }&#xD;&#xA;&#x9;&#x9;            return sb.toString();&#xD;&#xA;&#x9;&#x9;        } catch (Exception e) {&#xD;&#xA;&#x9;&#x9;            return null;&#xD;&#xA;&#x9;&#x9;        }&#xD;&#xA;&#x9;&#x9;    }&#xD;&#xA;&#x9;&#x9;}.calcMD5(&#xD;&#xA;&#x9;&#x9;    (&#xD;&#xA;&#x9;&#x9;    String.valueOf(row1.id_cliente)              + &quot;|&quot; +&#xD;&#xA;&#x9;&#x9;    row1.Nombre_Cliente == null ? &quot;&quot; : row1.Nombre_Cliente) + &quot;|&quot; +&#xD;&#xA;&#x9;&#x9;    String.valueOf(row1.NIT)              + &quot;|&quot; +&#xD;&#xA;&#x9;&#x9;    String.valueOf(row1.Fecha_Nacimiento) + &quot;|&quot; +&#xD;&#xA;&#x9;&#x9;    (row1.Pais_Nacimiento  == null ? &quot;&quot; : row1.Pais_Nacimiento)  + &quot;|&quot; +&#xD;&#xA;&#x9;&#x9;    (row1.Ciudad_Nacimiento == null ? &quot;&quot; : row1.Ciudad_Nacimiento) + &quot;|&quot; +&#xD;&#xA;&#x9;&#x9;    (row1.Genero == null ? &quot;&quot; : row1.Genero)&#xD;&#xA;&#x9;&#x9;) " type="id_String" nullable="true"/>
        <mapperTableEntries name="SCD_Fecha" expression="TalendDate.getCurrentDate() " type="id_Date" nullable="true"/>
      </outputTables>
      <inputTables sizeState="INTERMEDIATE" name="row1" matchingMode="UNIQUE_MATCH" lookupMode="LOAD_ONCE">
        <mapperTableEntries name="id_cliente" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="Nombre_Cliente" type="id_String" nullable="true"/>
        <mapperTableEntries name="NIT" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="Fecha_Nacimiento" type="id_String" nullable="true"/>
